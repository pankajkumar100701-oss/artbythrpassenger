# Copy to .env.local and fill in.
# First password for /studio (the host control panel). Once a new one is set in Studio → Security,
# this is no longer used; delete .studio/auth.json to fall back to it if the Studio password is forgotten.
ADMIN_PASSWORD=
# Random string, 32+ characters (e.g. `openssl rand -hex 32`). Changing it logs everyone out.
SESSION_SECRET=
# The only inbox that receives Studio login codes ("Forgot the password, or locked out?").
STUDIO_RECOVERY_EMAIL=
# Gmail account that sends the codes, and an App Password for it
# (Google Account → Security → 2-Step Verification → App passwords).
# Left empty in development, the code is printed in the `npm run dev` terminal instead.
SMTP_USER=
SMTP_PASS=
# Live site only (Vercel): the server disk is read-only, so Studio saves, logins and uploaded photos
# go to a Vercel Blob store. Vercel → Storage → Create → Blob, choose **Private**, connect it to this
# project, and this is filled in for you. Leave empty locally to keep using the files in /content.
BLOB_READ_WRITE_TOKEN=
